#!/usr/bin/make -f

# Keep cargo's registry/cache inside the build tree (Rules-Requires-Root: no,
# so the build runs unprivileged and must not write to a system CARGO_HOME).
export CARGO_HOME = $(CURDIR)/debian/cargo
# Tux Burner change: CI builds with network (CARGO_NET_OFFLINE=false CARGO_OFFLINE_FLAG=).
export CARGO_NET_OFFLINE ?= true
CARGO_OFFLINE_FLAG ?= --offline

%:
	dh $@

override_dh_auto_clean:
	rm -rf build dist *.egg-info src/*.egg-info debian/cargo burnerd/target

# Cargo's vendored checksum manifests include upstream Cargo.toml.orig files.
# Newer dh_clean versions remove those recursively unless vendor/ is excluded.
override_dh_clean:
	dh_clean -Xvendor/

override_dh_auto_configure:

override_dh_auto_build:
	TUX_BURNER_REQUIRE_NATIVE_LAYER=1 TUX_BURNER_REQUIRE_NATIVE_LAYER32=1 TUX_BURNER_BUILD_NVAPI_SHIM=0 TUX_BURNER_BUILD_DAEMON=0 python3 -m build --wheel --no-isolation --skip-dependency-check
	# Root daemon (tux-burnerd): compiled from the bundled Rust crate.
	# The source package contains the Cargo.lock-pinned vendor tree generated by
	# scripts/build-deb-source.sh, so Launchpad never needs network access.
	cargo build --release --locked $(CARGO_OFFLINE_FLAG) --manifest-path burnerd/Cargo.toml

override_dh_auto_install:
	python3 -m installer --destdir=$(CURDIR)/debian/tux-burner --prefix=/usr/lib/tux-burner dist/*.whl
	python3 packaging/debian/install-private-python.py
	# Package-owned source copied to the canonical /var/opt target at setup.
	install -D -m 0755 burnerd/target/release/tux-burnerd $(CURDIR)/debian/tux-burner/usr/libexec/tux-burnerd
	install -D -m 0644 packaging/man/tburn-cli.1 $(CURDIR)/debian/tux-burner/usr/share/man/man1/tburn-cli.1
	install -D -m 0644 packaging/man/tux-burner.1 $(CURDIR)/debian/tux-burner/usr/share/man/man1/tux-burner.1
	install -D -m 0644 packaging/man/tux-burnerd.8 $(CURDIR)/debian/tux-burner/usr/share/man/man8/tux-burnerd.8
	install -D -m 0644 CREDITS.md CHANGELOG.md docs/amd.md -t $(CURDIR)/debian/tux-burner/usr/share/doc/tux-burner/
	install -D -m 0644 docs/user-guide/*.md docs/user-guide/*.pdf -t $(CURDIR)/debian/tux-burner/usr/share/doc/tux-burner/

override_dh_auto_test:
